{
  "name": "internbuddy",
  "version": "0.1.0",
  "description": "Find Toronto/GTA internships and co-ops, and the people worth talking to about them. Runs on your own machine; AI optional.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "internbuddy": "dist/cli.js",
    "internbuddy-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist",
    "data",
    "config/profile.example.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "init": "node dist/cli.js init",
    "scout": "node dist/cli.js scout",
    "discover": "node dist/cli.js discover",
    "mcp": "node dist/mcp/main.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/mcp/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
